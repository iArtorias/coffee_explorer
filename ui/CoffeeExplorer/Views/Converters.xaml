<!-- Value converters shared by every dictionary and view. 'Templates.xaml' merges this file itself because a
     StaticResource inside a merged dictionary does not see keys of the application resources. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:CoffeeExplorer.Views">
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <views:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    <views:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
    <views:CountToVisibilityConverter x:Key="CountToVisibility" />
    <views:CountToVisibilityConverter x:Key="ZeroToVisibility" ZeroVisible="True" />
    <views:CountToBoolConverter x:Key="CountToBool" />
    <views:EnumEqualsConverter x:Key="EnumEquals" />
    <views:BoolToBoldConverter x:Key="BoolToBold" />
</ResourceDictionary>