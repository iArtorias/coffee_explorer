<Application x:Class="CoffeeExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeService inserts 'Light/Dark.xaml' and 'IconsLight/IconsDark.xaml' in front at startup.
                 'Templates.xaml' merges 'Converters.xaml' and 'Controls.xaml' itself, StaticResource lookups inside
                 templates of a merged dictionary only see that dictionary and what it merges. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppLogo.xaml" />
                <ResourceDictionary Source="Views/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>