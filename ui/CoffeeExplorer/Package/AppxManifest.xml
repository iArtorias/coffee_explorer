<?xml version="1.0" encoding="utf-8"?>
<!--
    Sparse package of Coffee Explorer: no files of its own besides the logos, the program folder is its external location.
    It only exists for the Windows 11 compact context menu, which shows IExplorerCommand handlers of packaged apps:
    the COM surrogate loads CoffeeExplorer.Shell.dll from the program folder.

    Windows refuses unsigned packages with an executable activation, build.ps1 signs the package with a self-signed
    certificate (CN=Coffee Explorer, out\cert). Coffee Explorer asks once to trust it (Trusted People of the machine).
    The publisher must match the certificate subject. The class id must match CLSID_OPEN_COMMAND in
    shell\ContextMenu.cpp. Raise Version when this file changes.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity Name="CoffeeExplorer.ContextMenu"
            Publisher="CN=Coffee Explorer"
            Version="1.0.1.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Coffee Explorer</DisplayName>
    <PublisherDisplayName>Coffee Explorer</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="CoffeeExplorer" Executable="CoffeeExplorer.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="Coffee Explorer"
                          Description="Portable Executable editor"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OpenWithCoffeeExplorer" Clsid="5EA954C8-DDE2-46E2-8BE3-200CAB988D11" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Coffee Explorer context menu">
              <com:Class Id="5EA954C8-DDE2-46E2-8BE3-200CAB988D11" Path="CoffeeExplorer.Shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
